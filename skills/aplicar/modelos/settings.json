{
  "model": "claude-opus-5-5[1m]",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "maxEffortLevel": "high",
      "autoCompactWindow": 400000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium",
      "maxEffortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium",
      "maxEffortLevel": "high"
    },
    "claude-fable-5-2": {
      "autoCompactWindow": 400000
    },
    "claude-mythos-5-2": {
      "autoCompactWindow": 400000
    }
  },
  "cleanupPeriodDays": 14,
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-2",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)"
    ]
  },
  "disableClaudeAiConnectors": true,
  "extraKnownMarketplaces": {
    "claude-padrao": {
      "source": {
        "source": "github",
        "repo": "Kortek-Tecnologia/claude-padrao"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "padrao@claude-padrao": true
  }
}
