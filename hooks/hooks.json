{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/conferir-padrao.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/travar-modelo-subagent.sh\"",
            "timeout": 10,
            "statusMessage": "Modelo do subagent",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell|Monitor|Workflow|Cron(Create|Delete)|RemoteTrigger|(Enter|Exit)Worktree|SendMessage|SendToProject.*|PushNotification|TaskStop)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/trava-leitura.sh\"",
            "timeout": 10,
            "statusMessage": "Trava de leitura",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/cobrar-docs.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "if": "Bash(git *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/cobrar-docs.sh\"",
            "timeout": 10,
            "statusMessage": "Doc do diff"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "if": "PowerShell(git *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/cobrar-docs.sh\"",
            "timeout": 10,
            "statusMessage": "Doc do diff"
          }
        ]
      }
    ]
  }
}
