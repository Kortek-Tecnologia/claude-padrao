{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/conferir-padrao.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/travar-modelo-subagent.sh\"",
            "timeout": 10,
            "statusMessage": "Modelo do subagent"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/trava-leitura.sh\"",
            "timeout": 10,
            "statusMessage": "Trava de leitura",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
